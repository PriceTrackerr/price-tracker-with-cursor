{
  "version": 2,
  "builds": [
    {
      "src": "api/cron/update-prices.ts",
      "use": "@vercel/node"
    },
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/cron/update-prices",
      "dest": "api/cron/update-prices.ts"
    },
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "functions": {
    "api/cron/update-prices.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/update-prices",
      "schedule": "0 */12 * * *"
    }
  ]
}