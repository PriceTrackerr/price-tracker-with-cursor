{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs18.x",
      "maxDuration": 10
    },
    "api/cron/update-prices.ts": {
      "runtime": "nodejs18.x",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/update-prices",
      "schedule": "0 */12 * * *"
    }
  ]
}