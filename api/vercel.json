{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "src/index.ts": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/update-prices",
      "schedule": "0 */12 * * *"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}