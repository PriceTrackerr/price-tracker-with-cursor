{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/update-prices",
      "schedule": "0 */12 * * *"
    }
  ],
  "functions": {
    "src/index.ts": {
      "includeFiles": "data/**"
    }
  }
}