{
  "name": "price-tracker-backend",
  "version": "1.0.0",
  "description": "Backend for Real Price Tracker",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "demo:advanced-features": "ts-node scripts/demoAdvancedFeatures.ts",
    "test:condition-scoring": "ts-node -e \"import('./src/services/conditionScoringService').then(m => new m.default().analyzeCondition({title: 'iPhone 14 Pro Used', description: 'Excellent condition, minor scratches'}))\"",
    "test:coupon-stacking": "ts-node -e \"import('./src/services/freeCouponService').then(m => new m.default().findCoupons('amazon'))\"",
    "test:global-arbitrage": "ts-node -e \"import('./src/services/currencyService').then(m => new m.default().getExchangeRate('USD', 'EUR'))\"",
    "test:ebay-service": "ts-node -e \"import('./src/services/ebayService').then(m => new m.default().searchProducts('iPhone 14 Pro'))\""
  },
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@supabase/supabase-js": "^2.56.0",
    "@types/socket.io": "^3.0.1",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.5.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "natural": "^8.1.0",
    "node-cron": "^3.0.2",
    "nodemailer": "^7.0.9",
    "openai": "^5.12.2",
    "playwright": "^1.54.2",
    "price-tracker-backend": "file:",
    "socket.io": "^4.8.1",
    "string-similarity": "^4.0.4",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cheerio": "^0.22.31",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.2.5",
    "@types/node-cron": "^3.0.7",
    "@types/nodemailer": "^6.4.8",
    "@types/string-similarity": "^4.0.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.5.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "keywords": [
