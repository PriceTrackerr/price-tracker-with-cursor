{
  "name": "real-price-tracker",
  "version": "1.0.0",
  "description": "A Chrome Extension and web tool for tracking product prices",
  "private": true,
  "workspaces": [
    "extension",
    "web-app",
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=web-app",
    "build": "npm run build --workspaces",
    "build:extension": "npm run build --workspace=extension",
    "build:web": "npm run build --workspace=web-app",
    "build:backend": "npm run build --workspace=backend",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "install:all": "npm install && npm install --workspace=extension && npm install --workspace=web-app && npm install --workspace=backend"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "price-tracker",
    "chrome-extension",
    "amazon",
    "aliexpress",
    "price-alerts",
    "shopping"
  ],
  "author": "Real Price Tracker Team",
  "license": "MIT",
  "dependencies": {
    "@eslint/config-array": "^0.21.0",
    "@eslint/object-schema": "^2.1.6",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "eslint": "^9.30.1",
    "express-rate-limit": "^8.0.1",
    "firebase-admin": "^13.4.0",
    "glob": "^11.0.3",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "inflight": "^1.0.6",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.5",
    "puppeteer": "^24.11.2",
    "react-i18next": "^15.6.0",
    "rimraf": "^6.0.1",
    "string-similarity": "^4.0.4"
  }
}
