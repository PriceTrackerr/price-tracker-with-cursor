{
  "manifest_version": 3,
  "name": "Price Tracker",
  "version": "1.0.0",
  "description": "Track prices on Amazon,  and AliExpress, view price history, and get alerts when prices drop.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.it/*",
    "https://www.amazon.es/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.com.au/*",
    "https://www.aliexpress.com/*",
    "https://www.aliexpress.us/*",
    "https://www.ebay.com/*",
    "https://www.ebay.co.uk/*",
    "https://www.ebay.de/*",
    "https://www.ebay.fr/*",
    "https://www.ebay.it/*",
    "https://www.ebay.es/*",
    "https://www.ebay.ca/*",
    "https://www.ebay.com.au/*",
    "https://www.walmart.com/*",
    "https://www.walmart.ca/*",
    "https://www.shein.com/*",
    "https://us.shein.com/*",
    "https://www.shein.co.uk/*",
    "https://de.shein.com/*",
    "https://fr.shein.com/*",
    "https://it.shein.com/*",
    "https://es.shein.com/*",
    "https://www.bestbuy.com/*",
    "https://www.target.com/*",
    "https://price-tracker-with-cursor-web-app.vercel.app/*",
    "https://price-tracker-with-cursor-web-app-s.vercel.app/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://price-tracker-with-cursor-web-app.vercel.app/*",
      "https://price-tracker-with-cursor-web-app-s.vercel.app/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.com/gp/product/*",
        "https://www.amazon.com/dp/*",
        "https://www.amazon.com/product/*",
        "https://www.aliexpress.com/*",
        "https://www.aliexpress.us/*",
        "https://www.ebay.com/*",
        "https://www.ebay.co.uk/*",
        "https://www.ebay.de/*",
        "https://www.ebay.fr/*",
        "https://www.ebay.it/*",
        "https://www.ebay.es/*",
        "https://www.ebay.ca/*",
        "https://www.ebay.com.au/*",
        "https://www.walmart.com/*",
        "https://www.walmart.ca/*",
        "https://www.shein.com/*",
        "https://us.shein.com/*",
        "https://www.shein.co.uk/*",
        "https://de.shein.com/*",
        "https://fr.shein.com/*",
        "https://it.shein.com/*",
        "https://es.shein.com/*",
        "https://www.bestbuy.com/*",
        "https://www.target.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "injected.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}